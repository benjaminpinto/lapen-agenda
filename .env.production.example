# Production Environment Configuration
DATABASE_URL=postgresql://lapen_user:CHANGE_THIS_PASSWORD@postgres:5432/lapen_agenda
POSTGRES_USER=lapen_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# Security Configuration
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_MOCK_ACTIVE=false

# Environment
FLASK_ENV=production

# Frontend URL
FRONTEND_URL=https://your-domain.com

# Payment Configuration
PAYMENT_MOCK_ACTIVE=false
VITE_PAYMENT_MOCK_ACTIVE=false

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-production-token
MERCADOPAGO_PUBLIC_KEY=APP_USR-your-production-key
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-your-production-key
