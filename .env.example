# Security Configuration
ADMIN_PASSWORD=your-admin-password-here
SECRET_KEY=your-secret-key-min-32-chars-here

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_MOCK_ACTIVE=false

# Environment
FLASK_ENV=development

# Frontend URL (required for production, optional for development)
# Use this to set the correct URL for email verification links
# Example: https://lapen-agenda.vercel.app
FRONTEND_URL=

# Payment Configuration
PAYMENT_MOCK_ACTIVE=false
VITE_PAYMENT_MOCK_ACTIVE=false

# Stripe Configuration (Card Support)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Mercado Pago Configuration (PIX Support)
# Production Keys
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-access-token
MERCADOPAGO_PUBLIC_KEY=APP_USR-your-public-key
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-your-public-key
