# Docker Environment Configuration
DATABASE_URL=postgresql://lapen_user:lapen_password@postgres:5432/lapen_agenda

# Security Configuration
ADMIN_PASSWORD=admin123
SECRET_KEY=docker-secret-key-min-32-chars-change-in-production

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_MOCK_ACTIVE=true

# Environment
FLASK_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5001

# Payment Configuration
PAYMENT_MOCK_ACTIVE=true
VITE_PAYMENT_MOCK_ACTIVE=true

# Stripe Configuration (Card Support)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_PUBLISHABLE_KEY=pk_test_mock
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_mock

# Mercado Pago Configuration (PIX Support)
MERCADOPAGO_ACCESS_TOKEN=TEST-mock-token
MERCADOPAGO_PUBLIC_KEY=TEST-mock-key
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-mock-key
